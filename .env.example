# Database
POSTGRES_USER=xmrcheckout
POSTGRES_PASSWORD=xmrcheckout
POSTGRES_DB=xmrcheckout
DATABASE_URL=postgresql://xmrcheckout:xmrcheckout@db:5432/xmrcheckout

# Optional: Postgres backups (used by the `db-backup` Compose profile)
BACKUP_RETENTION_DAYS=7

# API authentication
API_KEYS=dev-key-1
API_KEY_ENCRYPTION_KEY=replace-with-fernet-key
COINGECKO_API_KEY=
INVOICE_RECONCILE_INTERVAL_SECONDS=30
# Seconds between quick checks of open in-person terminal invoices.
TERMINAL_RECONCILE_INTERVAL_SECONDS=5
# Hours after expiry that invoices are still checked for late payments.
LATE_PAYMENT_LOOKBACK_HOURS=48
# Hours until a new invoice expires when the request does not set an expiry.
INVOICE_DEFAULT_EXPIRY_HOURS=1
# Minutes until an invoice created from a payment link expires (1-1440).
PAYMENT_LINK_EXPIRY_MINUTES=30

# Founder donation wallet (view-only)
FOUNDER_PAYMENT_ADDRESS=
FOUNDER_VIEW_KEY=
DONATIONS_ENABLED=false

# Whether a wallet without an existing merchant record can connect.
# Self-hosting for yourself: connect your wallet once, then set false and restart.
SIGNUP_ENABLED=true

# Monero wallet RPC (view-only wallet generation + subaddresses)
MONERO_VERSION=0.18.5.3
MONERO_WALLET_RPC_URLS=http://wallet-rpc-reconciler-1:18083,http://wallet-rpc-reconciler-2:18083,http://wallet-rpc-reconciler-3:18083
MONERO_WALLET_RPC_USER=
MONERO_WALLET_RPC_PASSWORD=
MONERO_WALLET_RPC_WALLET_PASSWORD=
MONERO_WALLET_RPC_WALLET_DIR=/wallets
MONERO_WALLET_RPC_LOCK_TIMEOUT_SECONDS=15
MONERO_WALLET_READY_TIMEOUT_SECONDS=60
MONERO_WALLET_READY_POLL_INTERVAL_SECONDS=1

# Monero daemon (required)
# The wallet trusts the node it reads from: a hostile node, or anyone between you
# and it, can show payments that never happened. Use a node you run or trust.
# - Recommended: the bundled `monerod` service (start with `--profile local-daemon`)
# - Remote: only a node you run or trust; TLS to it is not certificate-checked
MONERO_DAEMON_URL=http://monerod:18081

# UI
API_BASE_URL=http://api:8000
SITE_URL=https://example.com

# Three days after confirmation or expiry before an invoice address can be reused.
# Must be longer than LATE_PAYMENT_LOOKBACK_HOURS.
SUBADDRESS_REUSE_COOLDOWN_SECONDS=259200

# Shared per-merchant rolling 24-hour allowance for public payment links.
PUBLIC_PAYMENT_LINK_DAILY_LIMIT=10

# Optional outgoing webhook relay (off by default); see README.md.
WEBHOOK_RELAY_ENABLED=false
WEBHOOK_RELAY_URL=
WEBHOOK_RELAY_TOKEN=
